// Universal Premium Booking Platform — data model (Phase 2).
//
// Portability: this schema targets PostgreSQL for dev/demo. For client
// deployments the datasource `provider` switches to "mysql" (see
// docs/DATABASE-COST-HOSTING-POLICY.md). The schema deliberately avoids
// Postgres-only features (native arrays, partial indexes, db-side UUIDs):
//   - IDs are application-generated cuids (portable).
//   - Lists are modelled as relations or Json (Postgres jsonb / MySQL json).
//   - Enums, Decimal(10,2) and Json are supported on both dialects.
// Tenant isolation: every business-owned row carries businessId and is indexed
// on it; the repository layer scopes all access by businessId.

generator client {
  provider = "prisma-client-js"
  // "native" covers local dev; "rhel-openssl-3.0.x" is the Vercel/AWS Lambda
  // runtime. Listing it explicitly guarantees the Linux query-engine binary is
  // generated during the deploy build even if host auto-detection differs.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  RESCHEDULED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  FAILED
}

enum PaymentMode {
  NONE
  DEPOSIT
  FULL
}

enum DepositType {
  PERCENT
  FIXED
}

enum PaymentTxnType {
  CHARGE
  REFUND
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventRegistrationStatus {
  REGISTERED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum NotificationEvent {
  BOOKING_CREATED
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  BOOKING_COMPLETED
  BOOKING_REMINDER
  BOOKING_FOLLOW_UP
}

enum NotificationJobStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum NotificationLogStatus {
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  SELECT
  CHECKBOX
  RADIO
  DATE
  PHONE
  EMAIL
}

// ---------------------------------------------------------------------------
// Tenancy / core
// ---------------------------------------------------------------------------

model Business {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("UTC")
  currency  String   @default("USD")
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  websites             Website[]
  users                User[]
  roles                Role[]
  serviceCategories    ServiceCategory[]
  services             Service[]
  serviceExtras        ServiceExtra[]
  employees            Employee[]
  employeeServices     EmployeeService[]
  locations            Location[]
  serviceLocations     ServiceLocation[]
  employeeLocations    EmployeeLocation[]
  locationNotices      LocationNotice[]
  businessHours        BusinessHours[]
  employeeWorkingHours EmployeeWorkingHours[]
  breaks               Break[]
  holidays             Holiday[]
  timeOff              TimeOff[]
  blockedTimes         BlockedTime[]
  customers            Customer[]
  customerNotes        CustomerNote[]
  bookings             Booking[]
  bookingItems         BookingItem[]
  payments             Payment[]
  paymentTransactions  PaymentTransaction[]
  paymentSettings      PaymentSettings?
  notificationTemplate NotificationTemplate[]
  notificationJobs     NotificationJob[]
  notificationLogs     NotificationLog[]
  customFields         CustomField[]
  customFieldValues    CustomFieldValue[]
  formThemes           FormTheme[]
  formConfigurations   FormConfiguration[]
  webhooks             Webhook[]
  webhookDeliveries    WebhookDelivery[]
  auditLogs            AuditLog[]
  events               Event[]
  eventRegistrations   EventRegistration[]
}

model Website {
  id         String   @id @default(cuid())
  businessId String
  name       String
  domain     String?
  publicKey  String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  formConfigurations FormConfiguration[]

  @@index([businessId])
}

model User {
  id           String   @id @default(cuid())
  businessId   String
  email        String
  name         String
  passwordHash String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roles     UserRole[]
  employee  Employee?
  auditLogs AuditLog[]

  @@unique([businessId, email])
  @@index([businessId])
}

model Role {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([businessId, name])
  @@index([businessId])
}

// Global permission catalogue (not business-owned).
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model ServiceCategory {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services Service[]

  @@index([businessId])
}

model Service {
  id                  String   @id @default(cuid())
  businessId          String
  categoryId          String?
  name                String
  description         String?
  durationMinutes     Int
  bufferBeforeMinutes Int      @default(0)
  bufferAfterMinutes  Int      @default(0)
  price               Decimal  @default(0) @db.Decimal(10, 2)
  capacity            Int      @default(1)
  color               String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category     ServiceCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  extras       ServiceExtra[]
  employees    EmployeeService[]
  bookings     Booking[]
  bookingItems BookingItem[]
  locations    ServiceLocation[]

  @@index([businessId])
  @@index([businessId, categoryId])
}

model ServiceExtra {
  id              String   @id @default(cuid())
  businessId      String
  serviceId       String
  name            String
  price           Decimal  @default(0) @db.Decimal(10, 2)
  durationMinutes Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([serviceId])
}

enum LocationMode {
  IN_PERSON
  MOBILE
  VIRTUAL
}

model Location {
  id           String       @id @default(cuid())
  businessId   String
  name         String
  address      String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  latitude     Float?
  longitude    Float?
  mapUrl       String?
  phone        String?
  email        String?
  instructions String?
  mode         LocationMode @default(IN_PERSON)
  timezone     String?
  isDefault    Boolean      @default(false)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  business             Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings             Booking[]
  businessHours        BusinessHours[]
  employeeWorkingHours EmployeeWorkingHours[]
  blockedTimes         BlockedTime[]
  events               Event[]
  services             ServiceLocation[]
  employees            EmployeeLocation[]
  notices              LocationNotice[]

  @@index([businessId])
}

// Which services are offered at which locations. Absence of any row for a
// service means "available everywhere" (backward-compatible default).
model ServiceLocation {
  id         String @id @default(cuid())
  businessId String
  serviceId  String
  locationId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locationId])
  @@index([businessId])
  @@index([locationId])
}

// Which employees work at which locations. Absence of any row for an employee
// means "works everywhere" (backward-compatible default).
model EmployeeLocation {
  id         String @id @default(cuid())
  businessId String
  employeeId String
  locationId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([employeeId, locationId])
  @@index([businessId])
  @@index([locationId])
}

// Editable, optionally time-bounded notice/banner shown for a location (or
// business-wide when locationId is null).
model LocationNotice {
  id         String    @id @default(cuid())
  businessId String
  locationId String?
  title      String?
  message    String
  level      String?
  startsAt   DateTime?
  endsAt     DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([locationId])
}

// ---------------------------------------------------------------------------
// Staff & schedule
// ---------------------------------------------------------------------------

model Employee {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  firstName  String
  lastName   String
  email      String?
  phone      String?
  title      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business     Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  services     EmployeeService[]
  workingHours EmployeeWorkingHours[]
  timeOff      TimeOff[]
  blockedTimes BlockedTime[]
  bookings     Booking[]
  events       Event[]
  locations    EmployeeLocation[]

  @@unique([userId])
  @@index([businessId])
}

model EmployeeService {
  id            String   @id @default(cuid())
  businessId    String
  employeeId    String
  serviceId     String
  priceOverride Decimal? @db.Decimal(10, 2)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([employeeId, serviceId])
  @@index([businessId])
  @@index([serviceId])
}

model BusinessHours {
  id         String  @id @default(cuid())
  businessId String
  locationId String?
  dayOfWeek  Int // 0=Sunday .. 6=Saturday
  openTime   String // "HH:mm"
  closeTime  String // "HH:mm"
  isClosed   Boolean @default(false)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model EmployeeWorkingHours {
  id         String  @id @default(cuid())
  businessId String
  employeeId String
  locationId String?
  dayOfWeek  Int
  startTime  String // "HH:mm"
  endTime    String // "HH:mm"

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  breaks   Break[]

  @@index([businessId])
  @@index([employeeId])
}

model Break {
  id                     String  @id @default(cuid())
  businessId             String
  employeeWorkingHoursId String
  startTime              String // "HH:mm"
  endTime                String // "HH:mm"
  label                  String?

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workingHours EmployeeWorkingHours @relation(fields: [employeeWorkingHoursId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([employeeWorkingHoursId])
}

model Holiday {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  date            DateTime
  recurringYearly Boolean  @default(false)
  createdAt       DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model TimeOff {
  id         String   @id @default(cuid())
  businessId String
  employeeId String
  startAt    DateTime
  endAt      DateTime
  reason     String?
  approved   Boolean  @default(true)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([employeeId, startAt])
}

model BlockedTime {
  id         String   @id @default(cuid())
  businessId String
  employeeId String?
  locationId String?
  startAt    DateTime
  endAt      DateTime
  reason     String?
  createdAt  DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([employeeId, startAt])
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id         String   @id @default(cuid())
  businessId String
  firstName  String
  lastName   String
  email      String
  phone      String?
  timezone   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  notes         CustomerNote[]
  bookings      Booking[]
  registrations EventRegistration[]

  @@unique([businessId, email])
  @@index([businessId])
}

model CustomerNote {
  id           String   @id @default(cuid())
  businessId   String
  customerId   String
  authorUserId String?
  body         String
  createdAt    DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Bookings
// ---------------------------------------------------------------------------

model Booking {
  id            String        @id @default(cuid())
  businessId    String
  customerId    String
  serviceId     String
  employeeId    String?
  locationId    String?
  status        BookingStatus @default(PENDING)
  startAt       DateTime
  endAt         DateTime
  timezone      String        @default("UTC")
  priceTotal    Decimal       @default(0) @db.Decimal(10, 2)
  currency      String        @default("USD")
  notes         String? // customer-visible notes
  internalNotes String?
  source        String? // "widget" | "admin" | "api"
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service           Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  employee          Employee?          @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  location          Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items             BookingItem[]
  payment           Payment?
  customFieldValues CustomFieldValue[]
  notificationJobs  NotificationJob[]

  @@index([businessId])
  @@index([businessId, startAt])
  @@index([businessId, status])
  @@index([customerId])
  @@index([employeeId, startAt])
  @@index([serviceId])
}

model BookingItem {
  id             String  @id @default(cuid())
  businessId     String
  bookingId      String
  serviceId      String?
  serviceExtraId String?
  label          String
  quantity       Int     @default(1)
  unitPrice      Decimal @default(0) @db.Decimal(10, 2)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([bookingId])
}

model Payment {
  id          String        @id @default(cuid())
  businessId  String
  bookingId   String        @unique
  status      PaymentStatus @default(UNPAID)
  /// The amount required for this booking (per the payment policy at booking time).
  amount      Decimal       @default(0) @db.Decimal(10, 2)
  /// Net collected (charges − refunds); a cached rollup of the transaction ledger.
  amountPaid  Decimal       @default(0) @db.Decimal(10, 2)
  currency    String        @default("USD")
  provider    String?
  providerRef String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking      Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@index([businessId])
  @@index([businessId, status])
}

/// Immutable ledger of money movements against a Payment. amountPaid + status on
/// Payment are always recomputed from these rows inside the same transaction.
model PaymentTransaction {
  id              String         @id @default(cuid())
  businessId      String
  paymentId       String
  type            PaymentTxnType
  amount          Decimal        @db.Decimal(10, 2)
  method          String?
  reference       String?
  note            String?
  createdByUserId String?
  createdAt       DateTime       @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([paymentId])
}

/// Per-business payment policy (deposit / full / none) and offline collection
/// instructions. One row per business. No payment provider is mandatory.
model PaymentSettings {
  id           String      @id @default(cuid())
  businessId   String      @unique
  mode         PaymentMode @default(NONE)
  depositType  DepositType @default(PERCENT)
  depositValue Decimal     @default(0) @db.Decimal(10, 2)
  currency     String      @default("USD")
  instructions String?
  methods      Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model NotificationTemplate {
  id         String              @id @default(cuid())
  businessId String
  event      NotificationEvent
  channel    NotificationChannel
  subject    String?
  body       String
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, event, channel])
  @@index([businessId])
}

model NotificationJob {
  id             String                @id @default(cuid())
  businessId     String
  bookingId      String?
  event          NotificationEvent
  channel        NotificationChannel
  status         NotificationJobStatus @default(QUEUED)
  scheduledAt    DateTime              @default(now())
  attempts       Int                   @default(0)
  maxAttempts    Int                   @default(5)
  lastError      String?
  idempotencyKey String?               @unique
  payload        Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking  Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  logs     NotificationLog[]

  @@index([businessId])
  @@index([status, scheduledAt])
}

model NotificationLog {
  id                String                @id @default(cuid())
  businessId        String
  jobId             String?
  channel           NotificationChannel
  recipient         String
  status            NotificationLogStatus
  providerMessageId String?
  attempt           Int                   @default(1)
  error             String?
  createdAt         DateTime              @default(now())

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job      NotificationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Custom fields & forms
// ---------------------------------------------------------------------------

model CustomField {
  id         String          @id @default(cuid())
  businessId String
  key        String
  label      String
  type       CustomFieldType
  required   Boolean         @default(false)
  options    Json? // for SELECT/RADIO/CHECKBOX
  sortOrder  Int             @default(0)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  values   CustomFieldValue[]

  @@unique([businessId, key])
  @@index([businessId])
}

model CustomFieldValue {
  id            String @id @default(cuid())
  businessId    String
  customFieldId String
  bookingId     String
  value         String

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, customFieldId])
  @@index([businessId])
  @@index([bookingId])
}

model FormTheme {
  id         String   @id @default(cuid())
  businessId String
  name       String
  key        String // "minimal" | "luxury" | "modern" | "medical" | "editorial"
  tokens     Json // colors, fonts, radius, shadows, ...
  customCss  String?
  isPreset   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  configurations FormConfiguration[]

  @@index([businessId])
}

model FormConfiguration {
  id         String   @id @default(cuid())
  businessId String
  websiteId  String?
  themeId    String?
  name       String
  steps      Json // ordered step config
  fields     Json?
  settings   Json?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  website  Website?   @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  theme    FormTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)

  @@index([businessId])
}

// ---------------------------------------------------------------------------
// Integrations & audit
// ---------------------------------------------------------------------------

model Webhook {
  id         String   @id @default(cuid())
  businessId String
  url        String
  secret     String
  events     Json // list of subscribed event keys
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([businessId])
}

model WebhookDelivery {
  id           String                @id @default(cuid())
  businessId   String
  webhookId    String
  event        String
  status       WebhookDeliveryStatus @default(PENDING)
  statusCode   Int?
  requestBody  Json?
  responseBody String?
  attempts     Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  webhook  Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([webhookId])
}

model AuditLog {
  id          String   @id @default(cuid())
  businessId  String
  actorUserId String?
  action      String
  entity      String?
  entityId    String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, createdAt])
}

// ---------------------------------------------------------------------------
// Events (ticketed group classes / workshops)
// ---------------------------------------------------------------------------

model Event {
  id          String      @id @default(cuid())
  businessId  String
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  /// Total number of seats offered.
  capacity    Int         @default(0)
  price       Decimal     @default(0) @db.Decimal(10, 2)
  currency    String      @default("USD")
  locationId  String?
  /// Optional host/instructor for the event.
  employeeId  String?
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location      Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  employee      Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  registrations EventRegistration[]

  @@index([businessId, startAt])
  @@index([businessId, status])
}

model EventRegistration {
  id         String                  @id @default(cuid())
  businessId String
  eventId    String
  customerId String
  /// Number of seats this registration occupies.
  seats      Int                     @default(1)
  status     EventRegistrationStatus @default(REGISTERED)
  note       String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, eventId])
  @@index([businessId, customerId])
  @@index([eventId, status])
}
