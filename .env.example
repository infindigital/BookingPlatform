# ---------------------------------------------------------------------------
# Universal Premium Booking Platform — environment example
# Copy to `.env` (or `apps/web/.env.local`) and fill in values.
# NOTE: Database credentials stay SERVER-SIDE only. Never expose to the browser.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development

# Public base URL of the app/API (used by the widget + absolute links)
APP_URL=http://localhost:3000

# Logging: error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (Phase 2 will consume this). Cost policy: free/local Postgres for dev.
# Provider is switchable (postgresql | mysql) via the repository abstraction.
#   Local Postgres (dev/demo):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking?schema=public
#   Client production example (Hostinger MySQL/MariaDB):
# DATABASE_URL=mysql://user:password@host:3306/booking
# ---------------------------------------------------------------------------
