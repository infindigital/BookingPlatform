# ---------------------------------------------------------------------------
# Universal Premium Booking Platform — environment example
# Copy to `.env` (or `apps/web/.env.local`) and fill in values.
# NOTE: Database credentials stay SERVER-SIDE only. Never expose to the browser.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development

# Public base URL of the app/API (used by the widget + absolute links)
APP_URL=http://localhost:3000

# Logging: error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (Phase 2 will consume this). Cost policy: free/local Postgres for dev.
# Provider is switchable (postgresql | mysql) via the repository abstraction.
#   Local Postgres (dev/demo):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking?schema=public
#   Client production example (Hostinger MySQL/MariaDB):
# DATABASE_URL=mysql://user:password@host:3306/booking
# ---------------------------------------------------------------------------

# NextAuth (Auth.js) session secret — required in production.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Notification queue cron endpoint (Phase 14). When unset, POST
# /api/notifications/process returns 404 (disabled). Set a strong secret and
# call the endpoint from any scheduler (cron, Cloudflare, GitHub Actions).
# NOTIFICATIONS_CRON_SECRET=

# ---------------------------------------------------------------------------
# Email transport (Phase 15). Cost policy: NO mandatory paid email service —
# any SMTP mailbox works (the client's Hostinger email, Google Workspace, a
# self-hosted Postfix). Credentials stay SERVER-SIDE only. Leave unset to keep
# the built-in no-op transport (dev/demo still queues + logs, sends nothing).
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587                       # 587 = STARTTLS (default) · 465 = implicit TLS
# SMTP_SECURE=false                   # true for implicit TLS (auto-on for 465)
# SMTP_USER=bookings@yourbusiness.com
# SMTP_PASS=your-mailbox-password
# SMTP_TLS_REJECT_UNAUTHORIZED=true   # set false only for a known self-signed host
# EMAIL_FROM=bookings@yourbusiness.com          # required to enable email
# EMAIL_FROM_NAME=Your Business
# EMAIL_REPLY_TO=hello@yourbusiness.com
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Outbound webhooks (Phase 16). DB-backed delivery queue (no broker); an external
# scheduler drains it. When WEBHOOKS_CRON_SECRET is unset the /api/webhooks/process
# endpoint is disabled (404).
# WEBHOOKS_CRON_SECRET=
# Dev/test ONLY: allow http:// and private-host webhook targets. Never set in
# production — sending to internal hosts is an SSRF risk.
# WEBHOOKS_ALLOW_INSECURE=false
# ---------------------------------------------------------------------------
